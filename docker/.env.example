POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=app
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6380

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Local_Admin_Strong_Password_1!

JWT_ACCESS_TOKEN=change-me-access-token-secret-at-least-32-chars
JWT_REFRESH_TOKEN=change-me-refresh-token-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15min
JWT_REFRESH_EXPIRES=7days
APP_ENCRYPTION_KEY=change_me_32_byte_secret_key!!!!

MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=app-files
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

BACKEND_PORT=3000
FRONTEND_PORT=3001

LOG_FILE_ENABLED=true
BACKEND_LOG_FILE_PATH=/app/logs/backend.log
ZABBIX_ENABLED=false

# Skip comment moderation entirely (auto-APPROVED on submit) — local/dev testing only, never in prod.
COMMENTS_AUTO_APPROVE=false

# Caddy reverse proxy (docker-compose.caddy.yaml) — public HTTPS entrypoint, real deploys only.
# DNS for DOMAIN must already point at this server before starting Caddy, or ACME issuance fails.
DOMAIN=kennyhazzar.pro
CADDY_ACME_EMAIL=you@example.com

# --- Production-only overrides (leave unset for local dev — safe defaults apply automatically) ---
# On a real server behind Caddy/HTTPS, set all of these in docker/.env:
#   APP_ORIGIN=https://kennyhazzar.pro   # must match DOMAIN above, with https://
#   NEXT_PUBLIC_SITE_URL=https://kennyhazzar.pro  # baked into the frontend at BUILD time
#     (used for sitemap.xml/robots.txt/canonical URLs) — changing this needs a rebuild, a
#     plain container restart won't pick it up.
#   APP_ENV=production
#   LOG_LEVEL=info
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=strict
#   CSRF_ENABLED=false                    # keep false — the backend is never reached by the
#     browser directly (127.0.0.1-bound, only the frontend calls it server-to-server with its
#     own Bearer token), so the backend's cookie-based CSRF check has nothing to protect here.
#     Real CSRF protection for this app is the frontend's own sameSite=strict session cookies.
#   SWAGGER_ENABLED=false                 # this is a blog/portfolio, not a public API product
#   AUTH_SERVICE_CPU_LIMIT=<= your host's vCPU count, e.g. 0.5 on a 1-vCPU box (default 4.0
#     assumes a beefier dev machine — Docker refuses to start the container if this exceeds
#     what the host actually has)
